@{
    ViewData["Title"] = "Privacy & house rules";
}
<div class="narrow">
    <h1 class="page-title">Privacy &amp; house rules</h1>

    <div class="jw-panel">
        <h2 class="h5">What we store</h2>
        <ul>
            <li>Your email address and a securely hashed password, so you can log in.</li>
            <li>The jokes and riddles you submit, and the date you posted them.</li>
            <li>Simple counters: how many times each joke was read and laughed at.</li>
        </ul>
        <p class="mb-0">Only the part of your email <em>before</em> the @@ is shown next to your submissions. Your full address is never displayed.</p>
    </div>

    <div class="jw-panel">
        <h2 class="h5">House rules</h2>
        <ol class="mb-0">
            <li>Keep it friendly: nothing hateful, rude or aimed at a real person.</li>
            <li>Share jokes you'd tell at a family braai.</li>
            <li>One joke per post, with the punchline in the answer box so nobody gets spoiled.</li>
            <li>Riddles should have a fair answer someone could actually guess.</li>
        </ol>
    </div>

    <p class="text-soft small">Your theme choice (light/dark) and which jokes you've already laughed at are remembered in your own browser only.</p>
</div>
