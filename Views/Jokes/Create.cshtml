@model JokesWebApp.Models.Joke
@{
    ViewData["Title"] = "Share a joke or riddle";
    ViewData["SubmitLabel"] = "🚀 Publish";
}

<h1 class="page-title">Share a joke or riddle</h1>
<p class="text-soft">It'll appear on the site straight away with your name on it.</p>

<form asp-action="Create" method="post">
    <partial name="~/Views/Jokes/_JokeForm.cshtml" model="Model" view-data="ViewData" />
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
