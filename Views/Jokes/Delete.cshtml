@model JokesWebApp.Models.Joke
@{
    ViewData["Title"] = "Delete";
}

<div class="narrow">
    <h1 class="page-title">Delete this @(Model.Category == JokeCategory.Riddle ? "riddle" : "joke")?</h1>
    <p class="text-soft">This can't be undone. Its @Model.Likes laughs will go with it.</p>

    <div class="stage @(Model.Category == JokeCategory.Riddle ? "is-riddle" : "is-joke") mb-3">
        <span class="jw-badge">@Model.Emoji</span>
        <h2 class="stage-q h3">@Model.JokeQuestion</h2>
        <div class="stage-answer"><p>@Model.JokeAnswer</p></div>
    </div>

    <form asp-action="Delete" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">🗑️ Yes, delete it</button>
        <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Keep it</a>
    </form>
</div>
