@{
    ViewData["Title"] = "Search";
}
<div class="narrow text-center">
    <h1 class="page-title">🔎 Find a joke or riddle</h1>
    <p class="text-soft">Search by words in the question, the answer, or the person who posted it.</p>
    <form asp-action="Index" method="get" class="d-flex gap-2 mt-3">
        <input name="q" class="form-control form-control-lg" placeholder="e.g. penguin, staircase, clock…" autofocus />
        <button type="submit" class="btn btn-jw btn-lg">Search</button>
    </form>
    <p class="mt-4 small text-soft">
        Popular searches:
        <a asp-action="Index" asp-route-q="goes up">goes up</a> ·
        <a asp-action="Index" asp-route-q="cheese">cheese</a> ·
        <a asp-action="Index" asp-route-q="computer">computer</a> ·
        <a asp-action="Index" asp-route-q="egg">egg</a>
    </p>
</div>
